{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    { "name": "windows-vs2022", "generator": "Visual Studio 17 2022", "architecture": "x64", "binaryDir": "${sourceDir}/build", "cacheVariables": { "MANDELBROT_BUILD_PLUGIN": "ON" } }
  ],
  "buildPresets": [ { "name": "release", "configurePreset": "windows-vs2022", "configuration": "Release" } ],
  "testPresets": [ { "name": "release", "configurePreset": "windows-vs2022", "configuration": "Release", "output": { "outputOnFailure": true } } ]
}
